.venv/
__pycache__/
*.pyc
*.pyo
.DS_Store
*.egg-info/
dist/
build/
venv/

# Data (generated)
data/raw/
data/processed/*.parquet
data/processed/adversarial_eval.parquet

# Environment
.env

# Review queue DB
*.db

# Model checkpoints (large binary files)
models/**/checkpoint-*/
models/**/*.safetensors
models/**/*.bin

# Temp files
*.tmp
*.temp
*.log
# Keep the small final LoRA adapter tracked so the repo is runnable after clone
!models/qwen-injection-detector/best/
!models/qwen-injection-detector/best/*.safetensors
!models/qwen-injection-detector/best/*.bin

# Generated by scripts/eval_loso.py
data/loso/
configs/loso/
models/loso/

# SQLite sidecar files from the review queue
*.db-shm
*.db-wal

# Scratch benchmark output
scratch_bench_*.json

# Non-weight model files for experiment/candidate models (only the production adapter is tracked)
models/qwen-injection-detector-v*/
models/qwen-injection-detector/candidates/

# Large versioned training sets (uploaded to Hugging Face separately)
data/processed/v*/*.parquet
